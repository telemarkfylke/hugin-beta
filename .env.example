APP_NAME="Hugin" # Hugin for Telemark og Munin for Vestfold
DEFAULT_AGENT_ID="1000" # ID of the default agent to load on the home page
BODY_SIZE_LIMIT="536870912" # Max body size in bytes (536870912 = 512 MB, needed for audio uploads)
MISTRAL_API_KEY_PROJECT_DEFAULT="your-mistral-api-key"
OPENAI_API_KEY_PROJECT_DEFAULT="your-openai-api-key"
MOCK_DB="true" # If you want in-memory db
MONGODB_CONNECTION_STRING="mongodb+srv://..." # Production MongoDB connection
MONGODB_DB_NAME="mugin" # Name of database
MOCK_AUTH="true" # If you are running locally
MOCK_AUTH_ROLES="Employee,Admin" # Comma-separated list of role-values you want to mock the current user to have (corresponds to the values in APP_ROLE_X env variables)
MOCK_AUTH_GROUPS="" # Comma-separated list of groupIds you want to mock the current user to be a member of
MOCK_AUTH_FORCE_401="false" # Set to "true" to simulate a missing/expired EasyAuth session (triggers 401 on every request, MOCK_AUTH_ROLES not required)
MOCK_AUTH_FORCE_403="false" # Set to "true" to simulate an authenticated user with no agent access (triggers 403 from API, MOCK_AUTH_ROLES still required)
APP_ROLE_EMPLOYEE="Employee"
APP_ROLE_STUDENT="Student"
APP_ROLE_ADMIN="Admin"
APP_ROLE_AGENT_MAINTAINER="AgentMaintainer"
CANVAS_ENABLED="true"
OLLAMA_ENABLED="false" # Set to "true" (with OLLAMA_HOST) to offer the Ollama models to admins under "Avansert"
OLLAMA_HOST="https://ki.telemarkfylke.no/ollama" # Ollama base URL, no trailing slash
OLLAMA_BASIC_AUTH="<user>:<password>" # Optional, server-side only. Basic auth of the proxy in front of Ollama
TALE_TIL_NOTAT_URL="http://<ki-server>:<port>" # Internal URL of the tale-til-notat transcription service (no trailing slash)
TRANSCRIPTION_CALLBACK_SECRET="<random-secret>" # Shared secret to authenticate callbacks from tale-til-notat
TRANSCRIPTION_S3_BUCKET="hugin-transcription" # S3 bucket for transcription audio and Word documents (must exist). Uses the S3_ENDPOINT/S3_ACCESS_KEY/S3_SECRET_KEY below

RAGSERVICE_URL="https://ragservice-test.api.telemarkfylke.no"
RAGSERVICE_SCOPE="api://<scope>/.default"
RAGSERVICE_TOKEN="" # For local testing (Paste a token here )

# Hugin app-registrering (for OBO-bytte)
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
# Conversation encryption (optional - if unset, messages/titles/summaries are stored in plaintext)
# Covers conversation-messages (userInput/response) and conversations (title/summary).
# Generate a key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT keyset per environment (dev/prod) - each environment's own .env supplies its own.
# Key versions are free-form strings (a counter, a date, "prod-1" - whatever helps you track rotations).
CONVERSATION_ENCRYPTION_KEYS='{"2026-08":"<base64 of 32 random bytes>"}'
CONVERSATION_ENCRYPTION_ACTIVE_KEY="2026-08"

# SharePoint MCP Server (read-only tool source)
MCP_SHAREPOINT_ENABLED="false"
MCP_SHAREPOINT_URL="https://mcp-sharepoint-test.api.telemarkfylke.no/mcp"
MCP_SHAREPOINT_CLIENT_ID=""
MCP_SHAREPOINT_CLIENT_SECRET=""
MCP_SHAREPOINT_TENANT_ID="d64408ee-ce52-4a08-97ff-658c02ccf77b"
MCP_SHAREPOINT_SCOPE="api://6accdec8-ba90-4d48-9b6f-5657f3768593/.default"
# S3 storage (Silo behind the proxy on edge-01). Shared by transcription (TRANSCRIPTION_S3_BUCKET above) and the
# admin-only POC page at /s3-poc. S3_ENDPOINT MUST be https:// - an http:// endpoint switches S3 off (logged at use).
# Local Silo with a self-signed cert: start the dev server with NODE_EXTRA_CA_CERTS=<path to the cert> (see README).
# Server-side only - the browser never sees these. Use a key limited to Hugin's buckets, not the Silo root login.
S3_POC_ENABLED="false" # Only switches the /s3-poc test page on
S3_ENDPOINT="https://s3.ki.telemarkfylke.no" # No trailing slash
S3_ACCESS_KEY="<access-key>"
S3_SECRET_KEY="<secret-key>"
S3_BUCKET="hugin-poc" # Bucket for the /s3-poc page only. Must already exist
S3_REGION="us-east-1" # Optional. Silo ignores it, but request signing needs a value
USAGE_BUDGET="{"STUDENT":{"hour":0.3,"day":1},"ADMIN":{"hour":0.001}}"